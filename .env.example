# =====================================================================
# Smart Grocery Inventory & Procurement Management System
# Configuration & Environment Variables
# =====================================================================

# App Settings
APP_NAME="Smart Grocery Inventory & Procurement Agent"
APP_ENV="development"
DEBUG=true

# Database Configuration
# Out-of-the-box uses SQLite:
DATABASE_URL=sqlite:///smart_grocery.db
# For MySQL production:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/grocery_db

# Groq LLM API Key (Optional: system provides deterministic fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Slack Integration (Optional: system runs in presentation Demo Mode when empty)
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Slack Channels
SLACK_INVENTORY_ALERTS_CHANNEL=inventory-alerts
SLACK_ADMIN_APPROVALS_CHANNEL=admin-approvals
SLACK_PURCHASE_ORDERS_CHANNEL=purchase-orders
SLACK_SUPPLIER_UPDATES_CHANNEL=supplier-updates
SLACK_INVENTORY_REPORTS_CHANNEL=inventory-reports

# Authorized Role IDs (For signature & permission verification)
ADMIN_USER_IDS=["U0CL03S65SR", "U_ADMIN_01", "U_ADMIN_DEMO"]
SUPPLIER_USER_IDS=["U0CL94EJPU4", "U_SUPPLIER_APEX", "U_SUPPLIER_GOLDEN", "U_SUPPLIER_PUREOIL", "U_SUPPLIER_DEMO"]

# Email Notifications (Optional SMTP: e.g. smtp.gmail.com)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ADMIN_EMAIL=admin@groceryinventory.com
# SUPPLIER_EMAIL=orders@apexagro.com

# Stock Monitoring Scheduler (seconds)
STOCK_MONITOR_INTERVAL_SECONDS=30
