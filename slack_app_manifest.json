{
  "display_information": {
    "name": "Smart Grocery AI Agent",
    "description": "Agentic AI Grocery Inventory Monitoring & Procurement System",
    "background_color": "#1A535C"
  },
  "features": {
    "bot_user": {
      "display_name": "GroceryAgent",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/stock-check",
        "description": "Scan grocery inventory and report items below minimum threshold",
        "usage_hint": "[optional item name]",
        "should_escape": false
      },
      {
        "command": "/pending-orders",
        "description": "List all active purchase orders and pending admin approvals",
        "should_escape": false
      },
      {
        "command": "/inventory-report",
        "description": "Generate and post executive inventory health summary",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "channels:read",
        "channels:history",
        "groups:read",
        "commands",
        "im:history",
        "im:read",
        "im:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
